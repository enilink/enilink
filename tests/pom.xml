<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<artifactId>tests</artifactId>
	<packaging>pom</packaging>

	<parent>
		<groupId>net.enilink.platform</groupId>
		<artifactId>platform-parent</artifactId>
		<version>1.8.0-SNAPSHOT</version>
	</parent>

	<scm>
		<connection>${enilink.scm.connection}</connection>
		<developerConnection>${enilink.scm.developerConnection}</developerConnection>
		<url>${enilink.scm.url}</url>
	</scm>

	<properties>
		<path.to.root>..</path.to.root>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.platform</groupId>
			<artifactId>org.eclipse.osgi</artifactId>
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<scope>compile</scope>
		</dependency>

		<dependency>
			<groupId>biz.aQute.bnd</groupId>
			<artifactId>biz.aQute.tester.junit-platform</artifactId>
			<version>7.5.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>biz.aQute</groupId>
			<artifactId>osgi.enroute.junit.wrapper</artifactId>
			<version>4.13.0</version>
		</dependency>
		<dependency>
			<groupId>org.osgi</groupId>
			<artifactId>osgi.enroute.hamcrest.wrapper</artifactId>
			<version>1.3.0</version>
		</dependency>

		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-launcher</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.vintage</groupId>
			<artifactId>junit-vintage-engine</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
		</dependency>

		<dependency>
			<groupId>net.enilink.platform</groupId>
			<artifactId>net.enilink.platform.equinox.feature</artifactId>
			<version>${project.version}</version>
			<type>pom</type>
			<!-- don't include commons-logging for the test runs... -->
			<exclusions>
				<exclusion>
					<groupId>net.enilink.komma</groupId>
					<artifactId>net.enilink.commons.logging</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<profiles>
		<profile>
			<id>debug</id>
			<build>
				<plugins>
					<plugin>
						<groupId>biz.aQute.bnd</groupId>
						<artifactId>bnd-testing-maven-plugin</artifactId>
						<configuration>
							<testing>debug-*</testing>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>resolve</id>
			<build>
				<plugins>
					<plugin>
						<groupId>biz.aQute.bnd</groupId>
						<artifactId>bnd-resolver-maven-plugin</artifactId>
						<version>${bnd.version}</version>
						<configuration>
							<failOnChanges>false</failOnChanges>
							<bndruns>
								<bndrun>tests.bndrun</bndrun>
							</bndruns>
						</configuration>
						<executions>
							<execution>
								<goals>
									<goal>resolve</goal>
								</goals>
								<phase>validate</phase>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<modules>
		<module>net.enilink.platform.tests</module>
	</modules>

	<repositories>
		<!--
		  Required for bnd ${bnd.version}, which adds JUnit 6 support to
		  biz.aQute.tester.junit-platform (bndtools/bnd#7052). Remove once bnd 7.5.0 is released.
		-->
		<repository>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
			<id>bndtools-snapshot</id>
			<name>Bndtools Snapshot Repository</name>
			<url>https://bndtools.jfrog.io/bndtools/libs-snapshot</url>
		</repository>
		<!--
		  Required for mockito ${mockito.version}, which allows mockito-junit-jupiter to resolve
		  against JUnit 6 in OSGi (mockito/mockito#3867). Remove once mockito 5.24.1 is released.
		-->
		<repository>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
			<id>sonatype-snapshot</id>
			<name>Sonatype Snapshot Repository</name>
			<url>https://central.sonatype.com/repository/maven-snapshots</url>
		</repository>
	</repositories>

	<pluginRepositories>
		<!-- Required for the bnd ${bnd.version} Maven plugins, see the repository comment above. -->
		<pluginRepository>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
			<id>bndtools-snapshot</id>
			<name>Bndtools Snapshot Repository</name>
			<url>https://bndtools.jfrog.io/bndtools/libs-snapshot</url>
		</pluginRepository>
	</pluginRepositories>
</project>
